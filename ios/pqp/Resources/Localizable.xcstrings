    "Too many requests. Try again in %llds." : { "localizations" : { "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Muitas requisições. Tente de novo em %llds." } } } },
    "Could not read the server's response. %@" : { "localizations" : { "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Não deu para ler a resposta do servidor. %@" } } } },
