    "Empty conversation" : { "localizations" : { "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Conversa vazia" } } } },
    "Your friends.\nYour server.\nYour mess." : { "localizations" : { "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Seus amigos.\nSeu servidor.\nSua bagunça." } } } },
    "Group chat you actually own. Text that flies, voice that doesn't flake." : { "localizations" : { "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Chat em grupo que é seu de verdade. Texto que voa, voz que não falha." } } } },
    "Rooms for\neverything." : { "localizations" : { "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Salas para\ntudo." } } } },
    "Servers, channels, DMs. Voice you can drop into without scheduling it first." : { "localizations" : { "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Servidores, canais, DMs. Call que você entra sem marcar antes." } } } },
    "Yours to keep." : { "localizations" : { "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Seu para sempre." } } } },
