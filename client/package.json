{
  "name": "@pqp/client",
  "version": "0.0.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:stale-bundle": "playwright test -c playwright.stale-bundle.config.ts",
    "e2e:app-frame": "playwright test -c playwright.app-frame.config.ts",
    "e2e:locadora-guest": "playwright test -c playwright.locadora-guest.config.ts",
    "e2e:locadora-share-sound": "playwright test -c playwright.locadora-share-sound.config.ts",
    "e2e:camera-sync": "playwright test -c playwright.camera-sync.config.ts",
    "e2e:share-fast-start": "playwright test -c playwright.share-fast-start.config.ts",
    "e2e:jam": "playwright test -c playwright.jam.config.ts",
    "e2e:jam-site": "playwright test -c playwright.jam-site.config.ts",
    "bench:tokens": "node bench/theme-tokens.mjs",
    "bench": "node bench/theme-tokens.mjs && node bench/theme-runtime.mjs",
    "bench:runtime": "node bench/theme-runtime.mjs",
    "i18n:check": "node scripts/check-i18n.mjs",
    "prerender:copy": "node scripts/gen-prerender-copy.mjs",
    "og:image": "node scripts/og-image/render.mjs"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.22.4",
    "@clerk/localizations": "3.37.8",
    "@clerk/themes": "^2.4.57",
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@grafana/faro-web-sdk": "2.13.0",
    "@pqp/shared": "workspace:*",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@sapphi-red/web-noise-suppressor": "0.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hls.js": "1.7.4",
    "i18next": "^26.6.0",
    "livekit-client": "^2.23.0",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^2.6.0",
    "three": "^0.187.0",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@emulatorjs/core-fceumm": "4.2.3",
    "@emulatorjs/core-mgba": "4.2.3",
    "@emulatorjs/emulatorjs": "4.2.3",
    "@grafana/faro-rollup-plugin": "0.13.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vite": "^6.0.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "workbox-window": "^7.4.1"
  }
}
