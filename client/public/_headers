# Cloudflare Pages response headers.
#
# The service worker and the manifest must never be served from a cache. A
# stale `sw.js` is the one file that can pin a user to an old build
# indefinitely: the browser only learns there is a new worker by re-fetching
# this exact file, so if an intermediary answers it from cache the update check
# can never succeed.
/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

# Vite emits content-hashed filenames under /assets, so those are immutable by
# construction and safe to cache hard.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Static media that is not content-hashed (the landing hero at /images/hero/,
# the product screenshots, the icons, the loop videos). Pages' default for a
# plain file is four hours, which meant a returning visitor re-validated a
# megabyte of pictures several times a day. A day is fresh, and a week of
# stale-while-revalidate serves the cached copy instantly while a newer one is
# fetched behind it, so replacing a file in place still reaches everybody
# within a day of the next visit. Files that must change under the same name
# right now (a recaptured screenshot) should get a new name, the way the hero
# sizes do.
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/media/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/icons/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# RFC 9116 security contact must be text/plain, and RFC 9727 wants its media
# type stated — Pages would otherwise guess from the extension-less filename.
/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
/.well-known/api-catalog
  Content-Type: application/linkset+json

# Universal links. Apple's CDN fetches this file, not the device, so what it
# needs is to be JSON at a stable URL over https with no redirect — which is
# exactly what a static file in client/public/ on Pages is. The media type is
# stated for the same reason as the two above (extension-less filename), and the
# short cache is because this is the file you edit when a claimed path changes
# and then wait on: Apple's CDN can hold a stale copy for ~24h regardless, so
# there is nothing to gain by adding our own cache on top of that.
/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: public, max-age=300

# Android App Links, the twin of the file above. Fetched by the phone at
# install time (and by Google's verifier), must be application/json over https
# with no redirect. Which certificate fingerprints belong in it, and how to get
# the sideload one, is in docs/ANDROID.md under "App Links".
/.well-known/assetlinks.json
  Content-Type: application/json
  Cache-Control: public, max-age=300

# RFC 8288 discovery pointers on the homepage: where the API catalog and the
# live status live. Cheap, standard, and true — unlike advertising agent
# registration surfaces this product does not have.
/
  Link: </.well-known/api-catalog>; rel="api-catalog", <https://api.pqp.gg/status.json>; rel="status", </llms.txt>; rel="describedby"; type="text/plain", </sitemap.xml>; rel="sitemap"; type="application/xml"

# Agent-readable siblings of the pages above. Same reasoning as the two
# extension-less files at the top: Pages guesses a media type from the
# extension, and `.txt` guessed as `text/plain` is right while the two JSON
# documents and the SKILL.md are worth stating. The skill file is markdown that
# a fetcher should be able to read inline, hence the charset.
/llms.txt
  Content-Type: text/plain; charset=utf-8
/llms-full.txt
  Content-Type: text/plain; charset=utf-8
/.well-known/ai-catalog.json
  Content-Type: application/json
  Access-Control-Allow-Origin: *
/.well-known/agent-skills/index.json
  Content-Type: application/json
  Access-Control-Allow-Origin: *
/.well-known/agent-skills/*
  Access-Control-Allow-Origin: *
