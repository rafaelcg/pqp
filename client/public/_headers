# Cloudflare Pages response headers.
#
# The service worker and the manifest must never be served from a cache. A
# stale `sw.js` is the one file that can pin a user to an old build
# indefinitely: the browser only learns there is a new worker by re-fetching
# this exact file, so if an intermediary answers it from cache the update check
# can never succeed.
/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

# Vite emits content-hashed filenames under /assets, so those are immutable by
# construction and safe to cache hard.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# RFC 9116 security contact must be text/plain, and RFC 9727 wants its media
# type stated — Pages would otherwise guess from the extension-less filename.
/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
/.well-known/api-catalog
  Content-Type: application/linkset+json

# Universal links. Apple's CDN fetches this file, not the device, so what it
# needs is to be JSON at a stable URL over https with no redirect — which is
# exactly what a static file in client/public/ on Pages is. The media type is
# stated for the same reason as the two above (extension-less filename), and the
# short cache is because this is the file you edit when a claimed path changes
# and then wait on: Apple's CDN can hold a stale copy for ~24h regardless, so
# there is nothing to gain by adding our own cache on top of that.
/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: public, max-age=300

# RFC 8288 discovery pointers on the homepage: where the API catalog and the
# live status live. Cheap, standard, and true — unlike advertising agent
# registration surfaces this product does not have.
/
  Link: </.well-known/api-catalog>; rel="api-catalog", <https://api.pqp.gg/status.json>; rel="status"
