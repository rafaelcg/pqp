# Dependencies
node_modules/

# Build outputs
dist/
**/dist/
release/
**/release/
*.tsbuildinfo

# Env / secrets
.env
.env.*
!.env.example
*.local
client/.env
server/.env

# Electron
electron/release/
electron/dist/
electron/node_modules/
*.dmg
*.exe
*.AppImage
*.deb
*.snap
*.blockmap
*.yml.asc

# Logs & OS
logs/
*.log
.DS_Store
Thumbs.db

# Editors / tooling
.cursor/
.idea/
.vscode/
*.swp
*.swo

# Wrangler / Cloudflare
.wrangler/
.dev.vars
.mf/

# Test / coverage
coverage/
.nyc_output/

# Playwright
client/test-results/
client/playwright-report/
client/e2e-results.json

# iOS: the Xcode project is generated by XcodeGen from ios/project.yml.
# Committing it guarantees merge conflicts in an 8000-line pbxproj nobody reads.
ios/*.xcodeproj
ios/build/
ios/DerivedData/
# Also generated by XcodeGen, from the `entitlements:` block in project.yml —
# which is the reviewable copy. A committed one just drifts from it.
ios/pqp/pqp.entitlements
__pycache__/

# pnpm store cache — never commit
.pnpm-store/
