# Dependencies
# No trailing slash: `node_modules/` matches a directory only, and a symlinked
# node_modules is a FILE to git, so it slips past and gets committed as a
# 120000 entry pointing at somebody's home directory. Ask me how I know.
node_modules

# Build outputs
dist/
**/dist/
release/
**/release/
*.tsbuildinfo

# Env / secrets
.env
.env.*
!.env.example
*.local
client/.env
server/.env

# Electron
electron/release/
electron/dist/
electron/node_modules/
*.dmg
*.exe
*.AppImage
*.deb
*.snap
*.blockmap
*.yml.asc

# Logs & OS
logs/
*.log
.DS_Store
Thumbs.db

# Editors / tooling
.cursor/
.idea/
.vscode/
*.swp
*.swo

# Wrangler / Cloudflare
.wrangler/
.dev.vars
.mf/

# Test / coverage
coverage/
.nyc_output/

# Playwright
client/test-results/
client/playwright-report/
client/e2e-results.json

# iOS: the Xcode project is generated by XcodeGen from ios/project.yml.
# Committing it guarantees merge conflicts in an 8000-line pbxproj nobody reads.
ios/*.xcodeproj
ios/build/
ios/DerivedData/
# Also generated by XcodeGen, from the `entitlements:` block in project.yml —
# which is the reviewable copy. A committed one just drifts from it.
ios/pqp/pqp.entitlements
__pycache__/

# pnpm store cache — never commit
.pnpm-store/

# Firebase. Neither of these belongs in the repo.
#
# `google-services.json` is client config rather than a secret (it ships inside
# every APK), but it names the project and is per-developer, so it is fetched
# from the Firebase console rather than committed. `docs/ANDROID.md` says where
# to put it, and the build gates on its absence.
#
# The admin SDK service account IS a secret: it can send push as this project.
# It must never be in the working tree at all. Keep it outside the repo and
# load it into the server through Fly secrets.
google-services.json
**/google-services.json
*firebase-adminsdk*.json
