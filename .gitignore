# Dependencies
# No trailing slash: `node_modules/` matches a directory only, and a symlinked
# node_modules is a FILE to git, so it slips past and gets committed as a
# 120000 entry pointing at somebody's home directory. Ask me how I know.
node_modules

# Build outputs
dist/
**/dist/
release/
**/release/
*.tsbuildinfo

# Env / secrets
.env
.env.*
!.env.example
*.local
client/.env
server/.env

# Electron
electron/release/
electron/dist/
electron/node_modules/
*.dmg
*.exe
*.AppImage
*.deb
*.snap
*.blockmap
*.yml.asc

# Logs & OS
logs/
*.log
.DS_Store
Thumbs.db

# Editors / tooling
.cursor/
.idea/
.vscode/
*.swp
*.swo

# Wrangler / Cloudflare
.wrangler/
.dev.vars
.mf/

# Test / coverage
coverage/
.nyc_output/

# Playwright
client/test-results/
client/playwright-report/
client/e2e-results.json

# iOS: the Xcode project is generated by XcodeGen from ios/project.yml.
# Committing it guarantees merge conflicts in an 8000-line pbxproj nobody reads.
ios/*.xcodeproj
ios/build/
ios/DerivedData/
# Also generated by XcodeGen, from the `entitlements:` block in project.yml —
# which is the reviewable copy. A committed one just drifts from it.
ios/pqp/pqp.entitlements
__pycache__/

# pnpm store cache — never commit
.pnpm-store/

# Android signing, and the file that holds its passwords.
#
# `android/local.properties` is where `pqp.keystoreFile`, `pqp.keystorePassword`
# and `pqp.keyPassword` live (see android/app/build.gradle.kts). None of these
# were ignored until now, and nothing sensitive had been committed yet, but a
# single `git add -A` after generating an upload key would have published the
# key and its passwords to a public AGPL repo.
#
# The upload key is recoverable through Play App Signing if it is ever lost.
# A leaked one is not: anybody holding it can upload builds as this developer.
local.properties
*.jks
*.keystore
*.p12
