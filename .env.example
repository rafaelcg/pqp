# ---------------------------------------------------------------- Server
# Must be a direct or SESSION-mode endpoint: a transaction-mode pooler (e.g.
# Supabase :6543) silently breaks CLUSTER_BUS=postgres — LISTEN never receives.
DATABASE_URL=postgresql://pqp:pqp@localhost:5432/pqp
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
PORT=3001

# Set NODE_ENV=production in prod. DEV_AUTH_BYPASS below is ignored when it is.
# NODE_ENV=production

# Restrict which Clerk authorized parties (origins) are accepted (comma-separated).
CLERK_AUTHORIZED_PARTIES=

# Restrict CORS to these origins (comma-separated). Empty = allow all (*).
CORS_ALLOWED_ORIGINS=

# Postgres pool: set DATABASE_SSL=true for managed Postgres over public networking.
DATABASE_SSL=

# Local dev only: skip Clerk and accept the token "dev-local-token". Must be set
# on BOTH server and client (see VITE_DEV_AUTH_BYPASS below). The server refuses
# to start with this on when NODE_ENV=production, because the token is public.
DEV_AUTH_BYPASS=true

# CHARACTER ACCOUNTS — the house cast's production identity.
#
# Off unless this is exactly "true". When on, `Authorization: Bearer character:<token>`
# is accepted for an account in `character_accounts` whose SHA-256 matches and
# which has not been revoked; when off, the branch refuses before it touches the
# database. Unlike DEV_AUTH_BYPASS this is *meant* for production — it checks a
# 256-bit secret, not a public string — but it is explicit for the same reason:
# an environment that has not said the word cannot authenticate a character.
#
# Mint accounts with tools/ambient/scripts/provision.mjs. Runbook: docs/ambient-deploy.md.
CHARACTER_ACCOUNTS_ENABLED=false

# Local dev only, and only read when the bypass above is on: the email domains
# the dev account should present as *verified*, for trying SSO domain joining
# without a real Clerk account. Empty (the default) grants none. See docs/SSO.md.
# DEV_AUTH_EMAIL_DOMAINS=acme.com

# Set to true when the API sits behind a proxy you control (Railway, Fly,
# Cloudflare) — otherwise every client looks like the proxy and they share one
# rate-limit bucket. Leave false when the server is directly exposed, since
# X-Forwarded-For is caller-controlled there.
TRUST_PROXY=false

# Postgres pool size. Raise it only alongside your database's connection limit.
PG_POOL_MAX=10

# Share chat across more than one API instance. Unset (or "off") keeps every
# fan-out in-process, which is what this server has always done and the only
# supported setting for MESH voice — a mesh room's peer registry and its size
# ceiling are per-process, so two replicas split a call in half.
#
# "postgres" fans broadcasts, presence, typing, unread badges and evictions out
# over LISTEN/NOTIFY on the DATABASE_URL you already have; it takes one extra
# connection per instance, outside the pool. Rate limits stay per-instance
# either way — see the header of server/src/lib/rate-limit.ts for exactly what
# that multiplies.
CLUSTER_BUS=off

# GIF search (optional). Get a key at https://developers.giphy.com — it stays on
# the API and is never sent to the browser, so do NOT give it a VITE_ prefix.
# Unset: /api/gifs/* answers 503 and the client hides the GIF button entirely.
# Every upstream call is forced to rating=pg-13.
GIPHY_API_KEY=

# ------------------------------------------------------------ Attachments
# S3-compatible object storage for uploaded files. Leave these blank and the
# feature is entirely off: GET /api/attachments/config answers {"enabled":false}
# and the composer hides the attach button, exactly like GIF search above.
#
# Hosted is Cloudflare R2; self-hosters point the same vars at MinIO or any
# S3-compatible service, so there is only ever one code path to maintain.
#   R2     S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#          S3_REGION=auto           S3_FORCE_PATH_STYLE=false
#   MinIO  S3_ENDPOINT=http://localhost:9000
#          S3_REGION=us-east-1      S3_FORCE_PATH_STYLE=true
# MinIO addresses buckets by path rather than by subdomain, and a signature made
# for the wrong addressing style fails with SignatureDoesNotMatch, not 404.
#
# The key and secret are credentials: they stay on the API and must never get a
# VITE_ prefix, which would ship them in the browser bundle.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Optional custom domain in front of the bucket. Only affects the host that read
# URLs are signed for; uploads still go to S3_ENDPOINT.
S3_PUBLIC_BASE_URL=

# Upload cap in bytes. Lowering it takes effect immediately; raising it past the
# 10 MiB ceiling in packages/shared/src/attachments.ts does nothing on its own,
# because the mint request is rejected by that shared schema first.
MAX_ATTACHMENT_BYTES=10485760

# How long a presigned read URL stays valid (default 12h). This is a leak-window
# control, not a UX one — a tab open past the expiry heals itself by refetching
# a fresh URL when the image fails to load.
ATTACHMENT_URL_TTL_SECONDS=43200

# ------------------------------------------------- Image safety scanning
# Off by default. Empty means uploaded images are NOT scanned by anything, and
# every attachment row records `scan_status = 'unscanned'` — which is the honest
# statement that nobody looked, not a pass. See docs/CONTENT_SAFETY.md, which
# also covers what this does not and cannot detect.
#
# Bytes never reach this server. Whichever provider is chosen is handed a
# presigned URL good for two minutes and fetches the object itself.
#
#   openai       omni-moderation-latest. Free, no approval, self-serve, and it
#                accepts an image URL. Covers graphic violence; its
#                sexual/minors category is text-only, so it does NOT cover the
#                thing that matters most. The recommended starting point, and
#                not sufficient on its own.
#   sightengine  Self-serve, 2,000 ops/month free (max 500/day). The best
#                taxonomy for an adult platform: separates minors and gore.
#   webhook      Any HTTP endpoint you control — a Cloudflare Worker bound to
#                the R2 bucket is the intended shape. This is where a CSAM
#                hash-matching adapter (IWF Image Intercept, Project Arachnid
#                Shield) plugs in once you are approved for one.
CONTENT_SCAN_PROVIDER=

# provider=openai
OPENAI_API_KEY=
OPENAI_MODERATION_MODEL=omni-moderation-latest

# provider=sightengine
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
SIGHTENGINE_MODELS=nudity-2.1,gore,face-attributes

# provider=webhook. The token is sent as `Authorization: Bearer <token>`;
# without one your endpoint is scannable by anyone who finds its URL.
CONTENT_SCAN_URL=
CONTENT_SCAN_TOKEN=

# What happens when a scanner is configured but cannot answer — down, timing
# out, bad credentials, or returning something that is not a verdict.
#   closed (default)  the image is dropped from the message. The sender keeps
#                     the message and loses the file.
#   open              the image is posted unscanned. Still recorded as `error`
#                     on the row, so the gap is visible afterwards.
# `closed` is the whole point of turning scanning on. Change it knowing that.
CONTENT_SCAN_FAIL_MODE=closed

# Hard ceiling on how long a send waits for a scanner. A provider slower than
# this is a provider that already answered "error".
CONTENT_SCAN_TIMEOUT_MS=6000

# Scores at or above these block / queue for review, 0..1. Values outside that
# range are ignored rather than trusted. Note that adult nudity is NOT a
# blocking category here — pqp.gg is 18+ and its terms do not prohibit it.
CONTENT_SCAN_REJECT_THRESHOLD=0.9
CONTENT_SCAN_FLAG_THRESHOLD=0.55

# Whether an apparent minor in an image is on its own worth a moderator's time.
# Expect false positives on young-looking adults; the outcome is a queue entry,
# never a block. Set to `false` to turn it off.
CONTENT_SCAN_FLAG_MINORS=true

# How long a refused image is held before it and its object are deleted.
# Rejections labelled `illegal` or `csam_suspected` are NEVER auto-deleted at
# any age — read docs/CONTENT_SAFETY.md before touching one by hand.
CONTENT_SCAN_QUARANTINE_DAYS=30

# ---------------------------------------------------------------- Client
# (copy to client/.env — Vite requires the VITE_ prefix)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
VITE_API_URL=
VITE_WS_URL=
VITE_DEV_AUTH_BYPASS=true

# Public TestFlight join URL for the iOS beta CTA (footer, /vs-discord, mobile
# hero). Empty = CTA points at /vs-discord#ios-beta instead of a join link.
# Example: https://testflight.apple.com/join/XXXXXXXX — see docs/TESTFLIGHT.md
VITE_TESTFLIGHT_URL=

# ------------------------------------------------------------- TURN / ICE
# Preferred on the API, served via GET /api/ice-servers.
# Option A: static long-term credentials
TURN_URL=turn:your-turn-server.example.com:3478
TURN_USERNAME=your-username
TURN_CREDENTIAL=your-credential

# Option B: Cloudflare Realtime TURN (recommended for production)
# Create a TURN key in Cloudflare Dashboard → Realtime → TURN
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# Option C: Metered / Open Relay REST API
METERED_API_KEY=
METERED_DOMAIN=

# Optional client-side TURN fallback (baked into Pages build — prefer API instead)
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# ----------------------------------------------------------- Voice backend
# Chosen by the SERVER (GET /api/voice/backend) — setting the LIVEKIT_* vars
# below is all it takes, no client rebuild.
# Leave empty to follow the server; set to "mesh" to force peer-to-peer.
VITE_VOICE_BACKEND=

# LiveKit SFU — set all three to move voice off the mesh.
# Local: docker compose --profile livekit up -d  →  ws://localhost:7880 / devkey / secret
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Cloudflare Realtime SFU (hosted) — still a stub, falls back to mesh
CLOUDFLARE_REALTIME_APP_ID=
CLOUDFLARE_REALTIME_APP_SECRET=

# --------------------------------------------------- Instance moderators
# Who may read and resolve the INSTANCE report queue: reports about direct
# messages and group conversations, which have no server and therefore no
# server owner or admin who could be trusted with them. Comma-separated Clerk
# user ids (from the Clerk dashboard), NOT pqp user ids.
#
# Deliberately environment-only. No in-app action can grant this, because the
# queue contains reported conversation content — the same trust level as
# holding DATABASE_URL. Left empty there are no instance moderators at all:
# reports about conversations are still recorded, they are just not readable
# through the API by anybody. Server-scoped reports are unaffected and always
# go to that server's owner and admins.
#
# THIS ALSO UNLOCKS ACCOUNT TERMINATION (`DELETE /api/admin/users/:userId`) —
# the Tier 0 tool that deletes somebody else's account, their Clerk identity and
# their uploads. Same variable on purpose: both powers reach across every server
# on the instance, so both belong to whoever holds the deployment rather than to
# any role inside the app. Setting this hands the listed accounts BOTH. Left
# empty, neither exists for anybody, which is the right default for a
# self-hosted instance. See docs/TRUST_AND_SAFETY.md §3.3.
INSTANCE_MODERATOR_CLERK_IDS=

# ----------------------------------------------------------- Communities
# The public directory of joinable servers. OFF unless this is exactly "true".
#
# READ docs/CONTENT_SAFETY.md §"Communities" BEFORE SETTING THIS. Turning it on
# is not a feature toggle, it is a change of legal category: on 26 June 2025 the
# STF held Art. 19 of the Marco Civil partially unconstitutional and left an
# exemption covering e-mail, private meeting platforms and instant messaging —
# which is the bucket a chat app sits in. A public, searchable directory of rooms
# strangers can join with one tap is what moves an instance out of it and into
# "platform hosting public content", with a duty of care, presumed liability for
# boosted or bot-distributed content, an obligation to publish a complaint
# channel, and (in Brazil) a legal representative with full authority.
#
# What ships with it, so nothing has to be added later:
#   * every directory read requires auth, so the 18+ gate is never routed around
#   * a server you are banned from is invisible to you, not merely un-joinable
#   * reports about a community go to INSTANCE_MODERATOR_CLERK_IDS above and
#     never to that community's own owner
#   * `servers.is_community_suspended` pulls a listing with one UPDATE; there is
#     deliberately no in-app path that writes it
#
# CONTENT_SCAN_PROVIDER should be configured before this is. A public directory
# of rooms where anyone can upload an image, with nothing looking at the images,
# is the failure mode this repo already has a whole document about.
COMMUNITIES_ENABLED=false

# ---------------------------------------------------------------- Electron
VITE_APP_URL=http://localhost:5173

# Web Push (server). Generate once: npx web-push generate-vapid-keys
# All three required or push stays off entirely. Subject is a mailto: or https: URL.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# APNs (server) — native iOS pushes. The other leg of the same feature: same
# triggers, same content-free defaults, different transport. See the
# Notifications section of docs/IOS.md for the end-to-end check.
#
# APNS_KEY_ID / APNS_TEAM_ID / APNS_PRIVATE_KEY are all required or the APNs leg
# stays off; the topic and environment have working defaults.
#   APNS_PRIVATE_KEY  the PEM *contents* of the AuthKey_XXXXXXXXXX.p8, not a
#                     path. Literal `\n` between the lines is accepted, which is
#                     what a shell that cannot hold newlines will produce.
#   APNS_TOPIC        the app's bundle id. Default gg.pqp.app.
#   APNS_ENVIRONMENT  sandbox for builds run from Xcode, production for
#                     TestFlight and the App Store. Default production —
#                     getting this wrong presents as "registration works,
#                     notifications never arrive".
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_TOPIC=gg.pqp.app
APNS_ENVIRONMENT=production
