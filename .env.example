# ---------------------------------------------------------------- Server
DATABASE_URL=postgresql://pqp:pqp@localhost:5432/pqp
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
PORT=3001

# Set NODE_ENV=production in prod. DEV_AUTH_BYPASS below is ignored when it is.
# NODE_ENV=production

# Restrict which Clerk authorized parties (origins) are accepted (comma-separated).
CLERK_AUTHORIZED_PARTIES=

# Restrict CORS to these origins (comma-separated). Empty = allow all (*).
CORS_ALLOWED_ORIGINS=

# Postgres pool: set DATABASE_SSL=true for managed Postgres over public networking.
DATABASE_SSL=

# Local dev only: skip Clerk and accept the token "dev-local-token". Must be set
# on BOTH server and client (see VITE_DEV_AUTH_BYPASS below). The server refuses
# to start with this on when NODE_ENV=production, because the token is public.
DEV_AUTH_BYPASS=true

# Set to true when the API sits behind a proxy you control (Railway, Fly,
# Cloudflare) — otherwise every client looks like the proxy and they share one
# rate-limit bucket. Leave false when the server is directly exposed, since
# X-Forwarded-For is caller-controlled there.
TRUST_PROXY=false

# Postgres pool size. Raise it only alongside your database's connection limit.
PG_POOL_MAX=10

# GIF search (optional). Get a key at https://developers.giphy.com — it stays on
# the API and is never sent to the browser, so do NOT give it a VITE_ prefix.
# Unset: /api/gifs/* answers 503 and the client hides the GIF button entirely.
# Every upstream call is forced to rating=pg-13.
GIPHY_API_KEY=

# ---------------------------------------------------------------- Client
# (copy to client/.env — Vite requires the VITE_ prefix)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
VITE_API_URL=
VITE_WS_URL=
VITE_DEV_AUTH_BYPASS=true

# ------------------------------------------------------------- TURN / ICE
# Preferred on the API, served via GET /api/ice-servers.
# Option A: static long-term credentials
TURN_URL=turn:your-turn-server.example.com:3478
TURN_USERNAME=your-username
TURN_CREDENTIAL=your-credential

# Option B: Cloudflare Realtime TURN (recommended for production)
# Create a TURN key in Cloudflare Dashboard → Realtime → TURN
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# Option C: Metered / Open Relay REST API
METERED_API_KEY=
METERED_DOMAIN=

# Optional client-side TURN fallback (baked into Pages build — prefer API instead)
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# ----------------------------------------------------------- Voice backend
# Chosen by the SERVER (GET /api/voice/backend) — setting the LIVEKIT_* vars
# below is all it takes, no client rebuild.
# Leave empty to follow the server; set to "mesh" to force peer-to-peer.
VITE_VOICE_BACKEND=

# LiveKit SFU — set all three to move voice off the mesh.
# Local: docker compose --profile livekit up -d  →  ws://localhost:7880 / devkey / secret
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Cloudflare Realtime SFU (hosted) — still a stub, falls back to mesh
CLOUDFLARE_REALTIME_APP_ID=
CLOUDFLARE_REALTIME_APP_SECRET=

# ---------------------------------------------------------------- Electron
VITE_APP_URL=http://localhost:5173
