{
  "name": "@pqp/app-sdk",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "The SDK a pqp app (a sandboxed bundle) uses to talk to the pqp page. No dependencies.",
  "keywords": ["pqp", "app", "sdk", "sandbox", "iframe", "postmessage", "multiplayer"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafaelcg/pqp.git",
    "directory": "packages/app-sdk"
  },
  "homepage": "https://github.com/rafaelcg/pqp/tree/main/packages/app-sdk#readme",
  "bugs": "https://github.com/rafaelcg/pqp/issues",
  "type": "module",
  "sideEffects": false,
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "node scripts/build.mjs",
    "package": "node scripts/build.mjs && node scripts/stage.mjs && node scripts/check-package.mjs",
    "pack:dry": "pnpm run package && npm pack ./publish --dry-run",
    "publish:npm": "pnpm run package && node scripts/publish.mjs"
  },
  "devDependencies": {
    "@pqp/shared": "workspace:*",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
