{
  "name": "@pqp/app-sdk",
  "version": "0.0.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "The SDK a pqp app (a sandboxed bundle) uses to talk to the pqp page. No runtime dependencies.",
  "type": "module",
  "sideEffects": false,
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@pqp/shared": "workspace:*",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
