{
  "name": "@pqp/shared",
  "version": "0.0.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures:wire": "node --import ./scripts/ts-register.mjs scripts/gen-proto-vectors.mjs && node --import ./scripts/ts-register.mjs scripts/gen-constraints.mjs",
    "fixtures:wire:check": "node --import ./scripts/ts-register.mjs scripts/gen-proto-vectors.mjs --check && node --import ./scripts/ts-register.mjs scripts/gen-constraints.mjs --check"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
