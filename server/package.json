{
  "name": "@pqp/server",
  "version": "0.0.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && cp src/schema.sql dist/ && rm -rf dist/assets && cp -R src/assets dist/assets && mkdir -p dist/apps && cp src/apps/catalog.json dist/apps/",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@clerk/backend": "^1.23.3",
    "@pqp/shared": "workspace:*",
    "dotenv": "^16.4.7",
    "livekit-server-sdk": "^2.19.2",
    "pg": "^8.23.1",
    "web-push": "^3.6.7",
    "ws": "^8.22.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
