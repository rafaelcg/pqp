{
  "name": "@pqp/electron",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop shell for pqp",
  "homepage": "https://github.com/rafaelcg/pqp",
  "author": {
    "name": "pqp",
    "email": "pqp@users.noreply.github.com"
  },
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "prepack": "node scripts/ensure-client-dist.js",
    "predist": "node scripts/ensure-client-dist.js",
    "icons": "node scripts/generate-icons.js",
    "pack": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir",
    "dist": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder",
    "dist:mac": "node scripts/ensure-client-dist.js && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac",
    "dist:win": "node scripts/ensure-client-dist.js && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win",
    "dist:linux": "node scripts/ensure-client-dist.js && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --linux",
    "test": "node --test lib/*.test.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "gg.pqp.app",
    "productName": "pqp",
    "copyright": "Copyright \u00a9 pqp contributors",
    "extraMetadata": {
      "name": "pqp"
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "afterAllArtifactBuild": "./scripts/notarize-dmg.js",
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "rafaelcg",
        "repo": "pqp"
      }
    ],
    "extraResources": [
      {
        "from": "../client/dist",
        "to": "client",
        "filter": [
          "**/*"
        ]
      }
    ],
    "protocols": [
      {
        "name": "pqp",
        "schemes": [
          "pqp"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.social-networking",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "pqp",
            "CFBundleURLSchemes": [
              "pqp"
            ]
          }
        ],
        "NSMicrophoneUsageDescription": "pqp needs microphone access for voice channels.",
        "NSCameraUsageDescription": "pqp needs camera access for video in voice channels."
      }
    },
    "dmg": {
      "sign": true,
      "writeUpdateInfo": false
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "mimeTypes": [
        "x-scheme-handler/pqp"
      ],
      "maintainer": "pqp <pqp@users.noreply.github.com>",
      "executableName": "pqp"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-${arch}-portable.${ext}"
    }
  }
}
