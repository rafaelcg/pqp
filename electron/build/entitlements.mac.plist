<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		Hardened runtime entitlements. Notarization requires the hardened
		runtime, and the hardened runtime breaks Electron unless the first
		three are present: V8 JITs, and it writes to memory pages it then
		executes.
	-->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<key>com.apple.security.cs.allow-dyld-environment-variables</key>
	<true/>
	<!--
		Electron ships frameworks signed by Electron, not by us; library
		validation would refuse to load them under our signature.
	-->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>

	<!--
		Voice. Without audio-input the microphone is denied under the hardened
		runtime even with NSMicrophoneUsageDescription set, and the app records
		silence with no error.
	-->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>

	<!-- API, WebSocket, WebRTC. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- The loopback static server used by PQP_LOAD_STATIC=1. -->
	<key>com.apple.security.network.server</key>
	<true/>

	<!-- Attachment upload / download pickers. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
