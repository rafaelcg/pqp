    <string name="delete_removed_profile">Seu perfil, seu identificador, sua foto e suas configurações.</string>
    <string name="delete_removed_messages">Todas as mensagens que você escreveu, em qualquer lugar, inclusive nas conversas diretas. As outras pessoas vão ver lacunas onde estavam suas mensagens.</string>
