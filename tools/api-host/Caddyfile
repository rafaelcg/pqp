# GLOBAL OPTIONS: which connections Caddy believes about who the viewer is.
# Must be the first block in the file. Cloudflare's published ranges (from
# https://www.cloudflare.com/ips-v4 and https://www.cloudflare.com/ips-v6,
# fetched 2026-09-18) are the only peers trusted to say who the viewer is, and
# `CF-Connecting-IP` is the header Cloudflare says it in; ufw on this box
# already restricts 80/443 to these same ranges (cloud-init.yaml /
# provision.sh), so nothing else can be the immediate connection. The result is
# Caddy's `{client_ip}` placeholder, which the `(upstreams)` snippet sends to
# the API as `X-Forwarded-For`. This is what the API's per-address limiters
# key on, so changing it changes the keying for ALL traffic (anon, sockets,
# every public route): see tools/api-host/README.md "Viewer address" before
# applying it.
{
	servers {
		trusted_proxies static \
 173.245.48.0/20 \
 103.21.244.0/22 \
 103.22.200.0/22 \
 103.31.4.0/22 \
 141.101.64.0/18 \
 108.162.192.0/18 \
 190.93.240.0/20 \
 188.114.96.0/20 \
 197.234.240.0/22 \
 198.41.128.0/17 \
 162.158.0.0/15 \
 104.16.0.0/13 \
 104.24.0.0/14 \
 172.64.0.0/13 \
 131.0.72.0/22 \
 2400:cb00::/32 \
 2606:4700::/32 \
 2803:f800::/32 \
 2405:b500::/32 \
 2405:8100::/32 \
 2a06:98c0::/29 \
 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

# Caddy in front of the pqp API box. Reverse-proxies api.pqp.gg to the
# api-a / api-b containers, WebSocket included — Caddy's reverse_proxy
# handles the Upgrade handshake for `/ws` automatically, no extra directive
# needed.
#
# TWO API CONTAINERS (docs/plans/ALWAYS_ON.md A0.2): the `upstreams` snippet
# below load-balances across both. Active health checking (`health_uri`)
# means a crashed or restarting replica is pulled out of rotation on its own
# — no dependency on Compose's `depends_on`/`restart` timing, and no change
# needed here for API_REPLICAS=1 (compose.yaml's rolling-update flip):
# api-b simply never resolves on the compose network in that mode, its
# health check fails every interval, and Caddy routes everything to api-a.
# Expect periodic "upstream unhealthy"/dial-refused log lines from Caddy
# while running single-replica; that is this mechanism working as intended,
# not a misconfiguration — see docs/deploy-vultr.md "Two replicas on one
# box".
(upstreams) {
	reverse_proxy api-a:3001 api-b:3001 {
		lb_policy round_robin
		# Active health checking: an upstream that fails this is excluded
		# from selection until it passes again. Short interval so a
		# redeploy's restart of one replica (compose.yaml's healthcheck
		# start_period is 30s) or a crash is noticed fast relative to the
		# reconnect-jitter window clients already tolerate (CLAUDE.md
		# pitfall #11).
		health_uri /health
		health_interval 5s
		health_timeout 3s
		# Belt-and-braces passive check: if a request to the upstream Caddy
		# picked still fails (a crash landing inside the active-check gap),
		# retry against the other upstream for up to this long before
		# giving the client an error. WebSocket upgrade requests are a
		# single connection attempt either way — this only affects new
		# connections, never an already-established `/ws` socket, which
		# just drops and reconnects per the drain contract below.
		lb_try_duration 5s
		flush_interval -1

		# THE VIEWER ADDRESS IS NOT SET HERE. `header_up X-Forwarded-For
		# {client_ip}` hands the API the address Caddy resolved for the viewer
		# (the global `servers` block at the top of this file: Cloudflare's
		# ranges are trusted, and `CF-Connecting-IP` is the header they vouch
		# for), so the one hop `TRUST_PROXY=true` reads in `clientAddress()`
		# (server/src/lib/rate-limit.ts) is the real person and not the
		# Cloudflare edge IP the connection arrived from. An earlier attempt (#713)
		# put `trusted_proxies` and `header_up ... {http.request.header.CF-Connecting-IP}`
		# in THIS block and a tcpdump on the box showed the API still got
		# an edge IP: since Caddy 2.7 the reverse_proxy-level `trusted_proxies`
		# is deprecated and Caddy's own X-Forwarded-For handling runs after
		# `header_up`, replacing the value with the untrusted-path default (the
		# connection's remote address). Only the server-level setting counts.
		header_up X-Forwarded-For {client_ip}

		# Let a `caddy reload` (every deploy, pqp-deploy.sh) drain open
		# WebSockets instead of cutting them: without this, Caddy closes
		# every open `/ws` connection the instant the new config swaps in.
		# 30s covers the client's own reconnect-jitter window (CLAUDE.md
		# pitfall #11) with room to spare. Only takes effect once a config
		# carrying this line has itself been loaded — the reload that
		# first applies it still closes sockets, so do that one outside a
		# party (tools/api-host/README.md "Apply").
		stream_close_delay 30s
	}
}

# TWO TLS MODES, because Cloudflare sits in front of this box either way
# (api.pqp.gg is proxied, orange-cloud — see docs/deploy-vultr.md "cutover"):
# pick ONE of the two site blocks below and delete or comment the other.
# Both give Cloudflare a certificate it will accept under "Full (strict)"
# SSL mode, which is the only mode that does not eventually get MITM'd or
# refused; do not run this box under Cloudflare "Flexible" (that terminates
# TLS at Cloudflare only, so a request replayed at Caddy over plain HTTP is
# indistinguishable from Cloudflare's own health probes, and this box's own
# `TRUST_PROXY` accounting assumes exactly one TLS-terminating hop in front
# of it — see fly.toml's TRUST_PROXY comment for why the hop count matters).
#
# MODE A (default below): Cloudflare Origin CA certificate on the box.
#   Generate one in Cloudflare dashboard -> SSL/TLS -> Origin Server ->
#   Create Certificate (RSA or ECDSA, hostnames api.pqp.gg, 15-year
#   validity is fine — Cloudflare is the only client that ever validates
#   it). Save the cert as certs/origin.pem and the key as certs/origin.key
#   next to this file (both 0600, NEVER in git — see docs/deploy-vultr.md).
#   No port 80 / ACME dependency, no rate limit, works even if Cloudflare's
#   proxy is the only thing that can ever reach this box on 443.
#
# MODE B: Caddy's automatic HTTPS (Let's Encrypt) instead. Cloudflare's
#   proxy passes the ACME HTTP-01 challenge through on port 80 even while
#   orange-cloud, so this works without an Origin CA cert. Simpler, but now
#   renewal depends on Let's Encrypt's own availability and rate limits, and
#   on port 80 staying reachable from Cloudflare's edge. Use this if you
#   would rather not manage the Origin CA cert file on the box (e.g. a
#   self-host without Cloudflare in front at all — point DNS straight at the
#   box and this mode alone gives you a real, publicly-trusted cert).

# --- MODE A: Cloudflare Origin CA -------------------------------------------
api.pqp.gg {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key

	# Answer Fly's own health path the same way so the same external
	# monitors (docs/MONITORING.md) work unmodified against this box.
	handle /health {
		import upstreams
	}

	# Replica-split Prometheus metrics (api-a/api-b each hold their own
	# in-memory counters) are handled without any Caddy route: the exporter
	# scrapes this same round-robined GET /api/admin/metrics repeatedly and
	# dedups by the payload's own instanceId instead. A dedicated
	# /_replica/a /_replica/b pinned route was tried here and did not work
	# in production (fell through to the SPA catch-all); do not re-add one.
	# See tools/monitoring/pqp-api-metrics-exporter.py's module docstring
	# and docs/MONITORING.md.

	handle {
		import upstreams
	}

	encode gzip zstd
}

# --- MODE B: automatic HTTPS (Let's Encrypt) --------------------------------
# Comment out MODE A above and uncomment this block instead. Caddy needs no
# `tls` directive at all here — omitting it is what turns automatic HTTPS on.
