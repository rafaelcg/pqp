import { describe, expect, it } from "vitest";
import { FRAME_ANCESTORS, cspFor, headersFor, parseHeaders, renderHeaders, ruleForVersion } from "./headers.mts";

const BASE =
  "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; media-src blob:; connect-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors https://pqp.gg https://www.pqp.gg https://pqp-3yr.pages.dev https://*.pqp-3yr.pages.dev http://localhost:5173";

describe("cspFor", () => {
  it("is the D5 base with no sandbox knobs", () => {
    expect(cspFor({})).toBe(BASE);
    expect(cspFor({ sandbox: { wasm: false, blobWorkers: false, localBlobs: false } })).toBe(BASE);
  });

  it("wasm adds 'wasm-unsafe-eval' to script-src only", () => {
    const csp = cspFor({ sandbox: { wasm: true, blobWorkers: false, localBlobs: false } });
    expect(csp).toContain("script-src 'self' 'wasm-unsafe-eval';");
    expect(csp.replace(" 'wasm-unsafe-eval'", "")).toBe(BASE);
  });

  it("localBlobs makes connect-src blob: and nothing else", () => {
    const csp = cspFor({ sandbox: { wasm: false, blobWorkers: false, localBlobs: true } });
    expect(csp).toContain("connect-src blob:;");
    expect(csp).not.toContain("data: blob:; font-src 'self'; media-src blob:; connect-src blob: data:");
    expect(csp.replace("connect-src blob:", "connect-src 'none'")).toBe(BASE);
  });

  it("blobWorkers adds worker-src blob:", () => {
    const csp = cspFor({ sandbox: { wasm: false, blobWorkers: true, localBlobs: false } });
    expect(csp).toContain("worker-src blob:;");
  });

  it("never emits unsafe-eval, script blob: or data: in connect-src, whatever the knobs", () => {
    const csp = cspFor({ sandbox: { wasm: true, blobWorkers: true, localBlobs: true } });
    expect(csp).not.toContain("'unsafe-eval'");
    expect(csp).not.toMatch(/script-src[^;]*blob:/);
    expect(csp).not.toMatch(/connect-src[^;]*data:/);
    expect(csp).not.toContain("'unsafe-inline'");
  });

  it("lists the pqp origins as frame-ancestors", () => {
    expect(FRAME_ANCESTORS).toContain("https://pqp.gg");
    expect(FRAME_ANCESTORS).toContain("http://localhost:5173");
    expect(cspFor({})).toContain(`frame-ancestors ${FRAME_ANCESTORS.join(" ")}`);
  });
});

describe("_headers", () => {
  const rule = ruleForVersion({ id: "pqp-eco", version: "1.0.0" } as never);

  it("has the immutable, nosniff, CORS and CSP headers on the version path", () => {
    expect(rule.pattern).toBe("/pqp-eco/1.0.0/*");
    const headers = new Map(rule.headers);
    expect(headers.get("Cache-Control")).toBe("public, max-age=31536000, immutable");
    expect(headers.get("X-Content-Type-Options")).toBe("nosniff");
    expect(headers.get("Cross-Origin-Resource-Policy")).toBe("cross-origin");
    expect(headers.get("Access-Control-Allow-Origin")).toBe("*");
    expect(headers.get("Content-Security-Policy")).toBe(BASE);
  });

  it("round-trips through render and parse", () => {
    const text = renderHeaders([rule]);
    expect(text).toContain("# Generated by tools/apps-build");
    expect(parseHeaders(text)).toEqual([rule]);
  });

  it("applies a rule to its own folder and to nothing else", () => {
    const rules = [rule];
    expect(headersFor(rules, "/pqp-eco/1.0.0/index.html").get("content-security-policy")).toBe(BASE);
    expect(headersFor(rules, "/pqp-eco/1.0.0/chunks/a.js").has("cache-control")).toBe(true);
    expect(headersFor(rules, "/pqp-eco/1.0.1/index.html").size).toBe(0);
    expect(headersFor(rules, "/other/1.0.0/index.html").size).toBe(0);
  });

  it("joins a header set by two matching rules, as Pages does", () => {
    const rules = parseHeaders("/a/*\n  X-One: 1\n/a/b/*\n  X-One: 2\n");
    expect(headersFor(rules, "/a/b/c").get("x-one")).toBe("1, 2");
  });
});
