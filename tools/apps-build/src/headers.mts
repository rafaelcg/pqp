import type { AppManifest } from "@pqp/shared";

/**
 * Where an app frame may be embedded: the production and preview origins of the
 * pqp client, plus the Vite dev server. Used as `frame-ancestors`, so a bundle
 * cannot be framed (and then probed) from a page of somebody else's.
 */
export const FRAME_ANCESTORS = [
  "https://pqp.gg",
  "https://www.pqp.gg",
  "https://pqp-3yr.pages.dev",
  "https://*.pqp-3yr.pages.dev",
  "http://localhost:5173",
] as const;

/**
 * The Content-Security-Policy of an app's frame document (PLAN D5 as amended by
 * the S0 spike). Nothing but the manifest's `sandbox` knobs widens it:
 *
 * - `wasm` adds `'wasm-unsafe-eval'` to `script-src`
 * - `localBlobs` makes `connect-src` `blob:` (still no network)
 * - `blobWorkers` adds `worker-src blob:`
 *
 * `'unsafe-eval'`, `script-src blob:` and `data:` in `connect-src` are never
 * emitted.
 */
export function cspFor(manifest: Pick<AppManifest, "sandbox">): string {
  const sandbox = manifest.sandbox ?? { wasm: false, blobWorkers: false, localBlobs: false };
  const directives = [
    "default-src 'none'",
    `script-src 'self'${sandbox.wasm ? " 'wasm-unsafe-eval'" : ""}`,
    "style-src 'self'",
    "img-src 'self' data: blob:",
    "font-src 'self'",
    "media-src blob:",
    `connect-src ${sandbox.localBlobs ? "blob:" : "'none'"}`,
  ];
  if (sandbox.blobWorkers) directives.push("worker-src blob:");
  directives.push(
    "base-uri 'none'",
    "form-action 'none'",
    `frame-ancestors ${FRAME_ANCESTORS.join(" ")}`,
  );
  return directives.join("; ");
}

export interface HeaderRule {
  /** A Cloudflare Pages `_headers` path pattern: exact, or ending in `/*`. */
  pattern: string;
  headers: Array<[name: string, value: string]>;
}

/**
 * The headers of one built version. They are per version path, immutable, and
 * every file of the bundle carries `Access-Control-Allow-Origin: *`: the frame
 * is an opaque origin, so it fetches its own module script and SRI-protected
 * stylesheet in CORS mode, and the pqp page fetches `assets[]` from the apps
 * origin. The files are the public, open-source bundle, so nothing is exposed
 * by that.
 */
export function ruleForVersion(manifest: AppManifest): HeaderRule {
  return {
    pattern: `/${manifest.id}/${manifest.version}/*`,
    headers: [
      ["Content-Security-Policy", cspFor(manifest)],
      ["Cache-Control", "public, max-age=31536000, immutable"],
      ["X-Content-Type-Options", "nosniff"],
      ["Referrer-Policy", "no-referrer"],
      ["Cross-Origin-Resource-Policy", "cross-origin"],
      ["Access-Control-Allow-Origin", "*"],
    ],
  };
}

const HEADER_BANNER = [
  "# Generated by tools/apps-build. Do not edit.",
  "# One rule per built app version: the frame's CSP, immutable caching, CORS for",
  "# the opaque-origin frame and for the page's asset fetches. docs/APPS.md, Packaging.",
];

export function renderHeaders(rules: HeaderRule[]): string {
  const blocks = rules.map((rule) =>
    [rule.pattern, ...rule.headers.map(([name, value]) => `  ${name}: ${value}`)].join("\n"),
  );
  return `${HEADER_BANNER.join("\n")}\n\n${blocks.join("\n\n")}\n`;
}

export function parseHeaders(text: string): HeaderRule[] {
  const rules: HeaderRule[] = [];
  for (const raw of text.split(/\r?\n/)) {
    if (raw.trim() === "" || raw.trimStart().startsWith("#")) continue;
    if (/^\s/.test(raw)) {
      const current = rules[rules.length - 1];
      const colon = raw.indexOf(":");
      if (!current || colon < 0) throw new Error(`_headers: header line outside a rule: ${raw}`);
      current.headers.push([raw.slice(0, colon).trim(), raw.slice(colon + 1).trim()]);
    } else {
      rules.push({ pattern: raw.trim(), headers: [] });
    }
  }
  return rules;
}

function patternToRegExp(pattern: string): RegExp {
  const source = pattern
    .split("*")
    .map((part) => part.replace(/[.+?^${}()|[\]\\]/g, "\\$&").replace(/:[A-Za-z]\w*/g, "[^/]+"))
    .join(".*");
  return new RegExp(`^${source}$`);
}

/**
 * The headers that apply to `path`, as Pages applies them: every matching rule
 * contributes, and a header set by two rules is joined with a comma.
 */
export function headersFor(rules: HeaderRule[], path: string): Map<string, string> {
  const out = new Map<string, string>();
  for (const rule of rules) {
    if (!patternToRegExp(rule.pattern).test(path)) continue;
    for (const [name, value] of rule.headers) {
      const key = name.toLowerCase();
      const previous = out.get(key);
      out.set(key, previous === undefined ? value : `${previous}, ${value}`);
    }
  }
  return out;
}
