    },
    {
      "id": 18,
      "title": "Success rate (24h)",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 26
      },
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
