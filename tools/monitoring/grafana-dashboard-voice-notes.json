        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "sum(pqp_api_voice_notes_sent{window=\"24h\"})",
          "legendFormat": "sent 24h"
