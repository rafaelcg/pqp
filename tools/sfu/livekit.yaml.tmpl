# pqp production SFU. Single node, no Redis, no webhooks. See docs/plans/SELF_HOSTED_LIVEKIT.md in the pqp repo.
port: 7880
rtc:
  udp_port: 7882
  tcp_port: 7881
  use_external_ip: true
turn:
  enabled: true
  domain: __TURN_DOMAIN__
  tls_port: 5349
  udp_port: 3478
  external_tls: false
  cert_file: /opt/livekit/certs/__TURN_DOMAIN__.crt
  key_file: /opt/livekit/certs/__TURN_DOMAIN__.key
keys:
  __LIVEKIT_API_KEY__: __LIVEKIT_API_SECRET__
room:
  auto_create: true
  empty_timeout: 300
  departure_timeout: 20
  max_participants: 0
logging:
  level: info
  json: true
  pion_level: error
  sample: true
prometheus_port: 6789
