# Standalone service — its own install, outside the pnpm workspace.
node_modules/
package-lock.json

# Runtime output. `state/` is per-community memory, the JSONL is the audit log.
state/
*.log.jsonl

# The real cast. `personas.example.yaml` is the checked-in template; the live
# communities are operational content, not source.
personas.*.yaml
!personas.example.yaml
