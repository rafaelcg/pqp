# Standalone service — its own install, outside the pnpm workspace.
#
# No trailing slash, deliberately. `node_modules/` matches a DIRECTORY only, and
# a symlink is a file to git — so linking this at an installed copy (which is
# what you do in a git worktree, to avoid a second npm install) sailed straight
# past the ignore and got committed as a 120000 entry pointing at somebody's
# home directory. Without the slash it matches both.
node_modules
package-lock.json

# Runtime output. `state/` is per-community memory and the placement file the
# seed script writes; the JSONL is the audit log.
state/
*.log.jsonl

# CHARACTER TOKENS. The only copy of a credential that authenticates as an
# account in a public server, and one that cannot be read back out of the
# database. It must never be in a commit, and it is listed before anything else
# an editor might tab-complete into `git add`.
secrets/
characters.json

# The real cast. `personas.example.yaml` is the checked-in template; the live
# communities are operational content, not source.
personas.*.yaml
!personas.example.yaml
