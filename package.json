{
  "name": "pqp",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm run --parallel --filter @pqp/client --filter @pqp/server dev",
    "build": "pnpm run -r --filter=!@pqp/electron build",
    "test": "pnpm run -r test",
    "typecheck": "pnpm run -r --filter=!@pqp/electron typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "soak:voice": "node scripts/voice-soak.mjs",
    "start": "pnpm --filter @pqp/server start",
    "electron:dev": "pnpm --filter @pqp/electron dev",
    "electron:dist": "pnpm --filter @pqp/client build && pnpm --filter @pqp/electron dist",
    "clerk:login": "clerk auth login",
    "clerk:init": "cd client && clerk init --app app_3GKdeu8xQ3JCXb7fNkY4jPe4pBT -y",
    "clerk:env": "cd client && clerk env pull && clerk env pull --file ../.env",
    "clerk:doctor": "clerk doctor",
    "load:chat": "node scripts/chat-load.mjs",
    "ambient:test": "cd tools/ambient && npm test",
    "ambient:scene": "cd tools/ambient && node src/runner.js --once --canned"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^4.1.10"
  }
}
