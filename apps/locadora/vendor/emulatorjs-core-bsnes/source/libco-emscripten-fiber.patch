+/* `memory` is a thread from co_create (bsnes passes its previous thread back); it is
+   re-initialised to start at `coentry`, or replaced when it is missing, too small,
+   or the one running now. */
+cothread_t co_derive(void *memory, unsigned int stacksize, void (*coentry)(void))
+{
+   co_fiber_t *co = (co_fiber_t *)memory;
+
+   co_init();
+   if (!co || co == co_active_ || !co->c_stack || co->c_stack_size < stacksize)
+   {
+      if (co && co != co_active_)
+         co_delete(co);
+      return co_create(stacksize, coentry);
+   }
+   emscripten_fiber_init(&co->fiber, co_thunk, coentry, co->c_stack, co->c_stack_size, co->asyncify_stack, ASYNCIFY_STACK_SIZE);
+   return (cothread_t)co;
+}
+
 void co_delete(cothread_t cothread)
 {
-   free(cothread);
+   co_fiber_t *co = (co_fiber_t *)cothread;
+
+   if (!co)
+      return;
+   free(co->c_stack);
+   free(co->asyncify_stack);
+   free(co);
 }
 
 void co_switch(cothread_t cothread)
 {
-   emscripten_fiber_t *old_fiber = co_active_;
-   co_active_ = (emscripten_fiber_t *)cothread;
+   co_fiber_t *old_fiber = co_active_;
+   co_active_ = (co_fiber_t *)cothread;
 
-   emscripten_fiber_swap(old_fiber, co_active_);
+   emscripten_fiber_swap(&old_fiber->fiber, &co_active_->fiber);
 }
